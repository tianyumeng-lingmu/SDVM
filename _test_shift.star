// 测试位运算 << >> >>>
main {
    thing main() {
        see("=== 测试 << ===\n");
        see("1 << 0 = "); see(1 << 0); see(" (期望 1)\n");
        see("1 << 1 = "); see(1 << 1); see(" (期望 2)\n");
        see("1 << 3 = "); see(1 << 3); see(" (期望 8)\n");
        see("1 << 10 = "); see(1 << 10); see(" (期望 1024)\n");
        see("3 << 2 = "); see(3 << 2); see(" (期望 12)\n");

        see("\n=== 测试 >> ===\n");
        see("8 >> 2 = "); see(8 >> 2); see(" (期望 2)\n");
        see("15 >> 1 = "); see(15 >> 1); see(" (期望 7)\n");
        see("100 >> 3 = "); see(100 >> 3); see(" (期望 12)\n");
        see("1 >> 0 = "); see(1 >> 0); see(" (期望 1)\n");

        see("\n=== 测试 >>> ===\n");
        see("8 >>> 2 = "); see(8 >>> 2); see(" (期望 2)\n");

        see("\n=== 混合运算 ===\n");
        m = 5;
        nc = 1 << (m - 1);
        see("nc = 1 << (5-1) = "); see(nc); see(" (期望 16)\n");

        see("\n=== 测试完成 ===\n");
    }
}
