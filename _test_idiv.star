// 测试 /^ 整除运算符
main {
    thing main() {
        see("=== 测试 /^ 整除 ===\n");
        see("7 /^ 3 = "); see(7 /^ 3); see(" (期望 2)\n");
        see("10 /^ 3 = "); see(10 /^ 3); see(" (期望 3)\n");
        see("100 /^ 7 = "); see(100 /^ 7); see(" (期望 14)\n");
        see("0 /^ 5 = "); see(0 /^ 5); see(" (期望 0)\n");
        see("27 /^ 4 = "); see(27 /^ 4); see(" (期望 6)\n");
        see("1000 /^ 8 = "); see(1000 /^ 8); see(" (期望 125)\n");

        // 混合运算
        see("\n=== 混合运算 ===\n");
        see("10 /^ 3 + 1 = "); see(10 /^ 3 + 1); see(" (期望 4)\n");
        see("(10 /^ 3) * 3 = "); see((10 /^ 3) * 3); see(" (期望 9)\n");

        // 与普通除法的区别
        see("\n=== 对比除法 ===\n");
        see("7 / 3 = "); see(7 / 3); see(" (浮点)\n");
        see("7 /^ 3 = "); see(7 /^ 3); see(" (整除)\n");

        see("\n=== 测试完成 ===\n");
    }
}
